# Copie este arquivo para .env.local e preencha os valores

# Banco de dados (use a URL do docker-compose em desenvolvimento)
DATABASE_URL=postgresql://sgai:sgai@localhost:5432/sgai

# Segredo para o NextAuth (gere um aleatório com: openssl rand -base64 32)
NEXTAUTH_SECRET=mude_para_string_aleatoria

# Configuração SMTP para envio de e-mails (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu@email.com
SMTP_PASS=sua_senha_de_app

# E-mail de destino para os alertas diários
ALERT_EMAIL_TO=seu@email.com

# Diretório para upload de PDFs
UPLOAD_DIR=/tmp/uploads

# Segredo para proteger a rota de cron
CRON_SECRET=mude_para_string_aleatoria

# URL pública da aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000
